# MongoDB credentials (used by docker-compose AND the app)
MONGO_USER=penguwave
MONGO_PASSWORD=change_me_strong_password
MONGO_URI=mongodb://penguwave:change_me_strong_password@127.0.0.1:27017/penguwave?authSource=admin

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# Static API key the frontend sends in X-Api-Key header
API_KEY=REDACTED_API_KEY

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173
